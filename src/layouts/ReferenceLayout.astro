---
// Shared layout for every page except the reader at /.
// Head (SEO, schema, social) is unchanged; the chrome is the Pothi system:
// one stylesheet, the running head, the colophon, the night-reading control.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import RunningHead from '../components/RunningHead.astro';
import Colophon from '../components/Colophon.astro';

const versionJson = JSON.parse(
	readFileSync(join(process.cwd(), 'public', 'version.json'), 'utf8'),
);
const siteVersion = versionJson.version || '1.0';
const lastUpdatedDisplay = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
}).format(new Date());

const {
	title,
	description,
	canonical,
	schema = null,
	robots = 'index,follow,max-image-preview:large,max-snippet:-1',
	ogType = 'article',
	prevUrl = null,
	nextUrl = null,
	colophonLabel = 'The Pothi',
} = Astro.props;

const siteName = 'Adya Mahakali 1000 Names';
const ogImage = 'https://1000namesofmakali.com/MaaAdyaKali_5.webp';
const fontHref =
	'https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Tiro+Devanagari+Sanskrit:ital@0;1&family=Noto+Serif+Devanagari:wght@400;600&display=swap';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="author" content="KaliPutra-Ashish" />
		<meta name="google" content="notranslate" />
		<meta name="theme-color" content="#faf3e3" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1a1410" media="(prefers-color-scheme: dark)" />
		<link rel="canonical" href={canonical} />
		{prevUrl && <link rel="prev" href={prevUrl} />}
		{nextUrl && <link rel="next" href={nextUrl} />}

		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Maa Adya Mahakali - Divine Goddess Kali" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Maa Adya Mahakali - Divine Goddess Kali" />

		<link rel="icon" type="image/webp" href="/MaaAdyaKali_5.webp" />
		<link rel="apple-touch-icon" href="/MaaAdyaKali_5.webp" />

		<meta name="color-scheme" content="light dark" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" href={fontHref} as="style" onload="this.onload=null;this.rel='stylesheet'" />
		<noscript><link href={fontHref} rel="stylesheet" /></noscript>
		<link rel="stylesheet" href="/pothi.css" />

		<script is:inline>
			(function () {
				try {
					var t = localStorage.getItem('pothi-theme');
					if (!t)
						t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
					if (t === 'night') document.documentElement.dataset.theme = 'night';
				} catch (e) {}
			})();
		</script>

		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<RunningHead />

		<main id="main" class="page" tabindex="-1">
			<div class="narrow">
				<slot />
			</div>
		</main>

		<Colophon version={siteVersion} lastUpdated={lastUpdatedDisplay} label={colophonLabel} />

		<script src="/pothi-theme.js" defer></script>
		<script is:inline>
			(function () {
				var year = new Date().getFullYear();
				document.querySelectorAll('[data-current-year]').forEach(function (node) {
					node.textContent = year;
				});
			})();
		</script>
	</body>
</html>
