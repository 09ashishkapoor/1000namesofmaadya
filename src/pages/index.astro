---
// Adya Mahakali Sahasranama — the reader.
// The first set of eleven is rendered at build time from src/data/name-mapping.json
// (Devanagari, IAST, common spelling, page slug) joined with the meaning data in
// public/data_chunk_1.json, so the sacred text is in the HTML with no extra network cost.
// public/data_chunk_*.json stays the source for the remaining sets.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { getStaticNamesData, getNameMapping } from '../lib/staticNames.js';
import ForeEdge from '../components/ForeEdge.astro';
import RunningHead from '../components/RunningHead.astro';
import Colophon from '../components/Colophon.astro';

const { ranges, totalCount } = getStaticNamesData();

const packageJson = JSON.parse(readFileSync(join(process.cwd(), 'package.json'), 'utf8'));
const versionJson = JSON.parse(readFileSync(join(process.cwd(), 'public', 'version.json'), 'utf8'));
const siteVersion = versionJson.version || '1.0';
const lastUpdatedDisplay = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
}).format(new Date());
const assetVersion = encodeURIComponent(packageJson.version || '1');
function versionedAsset(path) {
	return `${path}?v=${assetVersion}`;
}

const SET_SIZE = 11;
const TOTAL_SETS = Math.ceil(totalCount / SET_SIZE); // 98
const PRINTED_PAGES = 68;

const mapping = getNameMapping();
const mappingByNumber = new Map(mapping.rows.map((row) => [Number(row.number), row]));
const firstChunkEntries = JSON.parse(
	readFileSync(join(process.cwd(), 'public', 'data_chunk_1.json'), 'utf8'),
);

function shorten(text, limit = 640) {
	if (typeof text !== 'string') return '';
	if (text.length <= limit) return text;
	return `${text.slice(0, limit).replace(/[\s,;:]\S*$/, '')}…`;
}

// The first set of eleven: spelling forms from the mapping, meaning from the chunk.
const firstSet = firstChunkEntries.slice(0, SET_SIZE).map((entry) => {
	const row = mappingByNumber.get(Number(entry.index));
	return {
		number: Number(entry.index),
		dev: row?.devanagari ?? '',
		iast: row?.iast ?? '',
		common: row?.spelling_common ?? entry.english_name,
		slug: row?.page_slug ?? null,
		one: entry.english_one_line,
		elab: shorten(entry.english_elaboration),
	};
});
const leadName = firstSet[0];
const firstRangeLabel = `${firstSet[0].number}–${firstSet[firstSet.length - 1].number}`;

const readerBoot = {
	setSize: SET_SIZE,
	totalSets: TOTAL_SETS,
	totalCount,
	names: firstSet,
};

const fontHref =
	'https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Tiro+Devanagari+Sanskrit:ital@0;1&family=Noto+Serif+Devanagari:wght@400;600&display=swap';

const whyReasons = [
	{
		title: 'Protection',
		text: 'Many devotees turn to the Sahasranama as a steadying practice that helps them feel held, guarded, and less shaken by inner or outer disturbance.',
	},
	{
		title: 'Facing the Inner Obstacles',
		text: 'The recitation is often understood as a way of meeting anger, greed, attachment, pride, and confusion with more honesty and discipline.',
	},
	{
		title: 'Less Fear, More Steadiness',
		text: 'Returning to the names can calm the mind, soften fear, and make room for a more grounded kind of courage.',
	},
	{
		title: 'Grace',
		text: 'For many readers, regular practice is a way of opening themselves to grace, clarity, and a quieter sense of guidance.',
	},
	{
		title: 'Awakening',
		text: 'Over time, the repetition can deepen attention and devotion, making spiritual practice feel more inward, alive, and continuous.',
	},
];
