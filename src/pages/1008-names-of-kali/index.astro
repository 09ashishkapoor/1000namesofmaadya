---
import { getStaticNamesData } from '../../lib/staticNames.js';

const { namePages, ranges, totalCount, siteUrl } = getStaticNamesData();

const canonical = `${siteUrl}/1008-names-of-kali/`;
const title = '1008 Names of Kali — 1,072 vs 1,008 vs 1,000 Explained | Adya Mahakali';
const description =
	'How many names does Kali have? Understand the 1,008-name, 1,000-name and 1,072-name Kali Sahasranama counts, and read all 1,072 names with meanings.';

const faqs = [
	{
		question: 'How many names of Kali are there?',
		answer:
			'Hindu tradition preserves several Kali Sahasranama recensions and shorter stotra sets, so counts differ. You will see 1,000-name lists, 1,008-name lists, and this site\'s 1,072-name Adya Mahakali Sahasranama. All are devotional compilations rather than one fixed canonical count.',
	},
	{
		question: 'Are there 1,008 names of Kali?',
		answer:
			'Yes. One thousand and eight is a traditional and auspicious count used in stotras and in some Kali Sahasranama editions. This site\'s edition uses a longer 1,072-name sequence, which contains the full names-and-meanings set.',
	},
	{
		question: 'What is the difference between 1,000, 1,008 and 1,072 names?',
		answer:
			'"Sahasranama" literally means a thousand names, and 1,000 is used as a round title. 1,008 is a sacred count that appears in many stotras. 1,072 is the number of entries in this project\'s Adya Mahakali Sahasranama, which is the text behind every page on this site.',
	},
	{
		question: 'Where can I read all 1,072 names?',
		answer:
			'The complete list is available in the names hub, by 100-name ranges, on individual name pages, and as a free printable PDF from the download page.',
	},
];

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': `${canonical}#webpage`,
			name: title,
			description,
			url: canonical,
			inLanguage: 'en',
			isPartOf: { '@id': `${siteUrl}/#website` },
		},
		{
			'@type': 'BreadcrumbList',
			'@id': `${canonical}#breadcrumb`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
				{ '@type': 'ListItem', position: 2, name: '1008 Names of Kali', item: canonical },
			],
		},
		{
			'@type': 'FAQPage',
			'@id': `${canonical}#faq`,
			mainEntity: faqs.map((faq) => ({
				'@type': 'Question',
				name: faq.question,
				acceptedAnswer: { '@type': 'Answer', text: faq.answer },
			})),
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content="https://1000namesofmakali.com/MaaAdyaKali_5.webp" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://1000namesofmakali.com/MaaAdyaKali_5.webp" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs text summary" />
		<link rel="stylesheet" href="/static-pages.css" />
		<link rel="stylesheet" href="/landing-pages.css" />
		<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
	</head>
	<body class="names-static names-static--landing">
		<main>
			<nav class="breadcrumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/">Home</a></li>
					<li><span aria-current="page">1008 Names of Kali</span></li>
				</ol>
			</nav>

			<p class="page-kicker">Counts explained</p>
			<h1>1008 Names of Kali: 1,072 vs 1,008 vs 1,000</h1>

			<section class="hero-panel landing-intro">
				<p class="intro">
					Search results mix together "1,000 names of Kali", "1,008 names of Kali", and "Kali Sahasranama" lists.
					They are not a contradiction: different recensions, stotras, and devotional editions preserve different
					counts. This site's edition of the <strong>Adya Mahakali Sahasranama contains 1,072 names</strong> with
					English meanings, Devanagari, and transliteration — and you can read every one of them here.
				</p>
				<nav class="page-nav" aria-label="Page navigation">
					<ul>
						<li><a href="/names/">Read all {totalCount} names</a></li>
						<li><a href="/108-names-of-kali/">Start with 108 names</a></li>
						<li><a href="/kali-sahasranama-pdf/">Download the PDF</a></li>
					</ul>
				</nav>
			</section>

			<section class="landing-section">
				<h2>The three counts, side by side</h2>
				<ul>
					<li><strong>1,000 names:</strong> "Sahasranama" literally means "a thousand names." 1,000 is the traditional title and a round devotional count, not always the exact number of verses in an edition.</li>
					<li><strong>1,008 names:</strong> 1,008 is a sacred number in Hindu practice and appears in many stotras and Kali name lists. When a page says "1008 names of Kali", it usually refers to a specific stotra edition with that count.</li>
					<li><strong>1,072 names:</strong> this is the number of entries in the Adya Mahakali Sahasranama presented on this site. It is the text that powers the reader, the range pages, and every individual name page.</li>
				</ul>
				<p class="callout">
					If you arrived looking for a 1,008-name list: the full {totalCount}-name text here includes all the
					devotional material you are looking for, and you can take the first 108 names as a compact daily practice
					set.
				</p>
			</section>

			<section class="landing-section">
				<h2>Where the 1,072 names sit</h2>
				<p>
					The full Sahasranama is organized into {ranges.length} ranges of roughly one hundred names each. This makes
					the text easy to navigate both for reading and for search engines:
				</p>
				<table class="names-table">
					<caption>Adya Mahakali Sahasranama ranges</caption>
					<thead>
						<tr><th scope="col">#</th><th scope="col">Names</th><th scope="col">Start → end</th><th scope="col">Read</th></tr>
					</thead>
					<tbody>
						{ranges.map((range) => (
							<tr>
								<td>{range.rangeNumber}</td>
								<td>{range.start}–{range.end}</td>
								<td>{range.firstName.english} → {range.lastName.english}</td>
								<td><a href={range.path}>Read range</a></td>
							</tr>
						))}
					</tbody>
				</table>
				<p>
					Prefer one page per name? The <a href="/names/">names hub</a> links every range, and each entry links to its
					own page with the Devanagari spelling, alternate romanizations, and a longer meaning note.
				</p>
			</section>

			<section class="landing-section">
				<h2>Why the counts differ</h2>
				<p>
					A Sahasranama is a living devotional text, not a single fixed file. Manuscripts, regional editions, and
					modern compilations include different numbers of names, and devotional publishers sometimes round the
					count. A list sold or shared as "1,008 names of Kali" may be a shorter stotra, while a full Kali
					Sahasranama recension can run past a thousand entries. This site is explicit about its own count:
					<strong>{totalCount} names</strong>, each with a meaning and elaboration.
				</p>
				<p>
					If you are comparing lists, compare the actual names rather than the headline number. The same Goddess is
					invoked through many overlapping epithets, and a shorter practice set is often drawn from a longer
					Sahasranama exactly as the 108-name page here is.
				</p>
			</section>

			<section class="landing-section">
				<h2>Questions about the counts</h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<div class="faq-item">
							<h3>{faq.question}</h3>
							<p>{faq.answer}</p>
						</div>
					))}
				</div>
			</section>

			<section class="landing-section">
				<h2>Continue reading</h2>
				<ul>
					<li><a href="/108-names-of-kali/">108 names of Maa Kali with meanings</a></li>
					<li><a href="/kali-sahasranama-lyrics/">Kali Sahasranama lyrics and chant order</a></li>
					<li><a href="/kali-sahasranama-benefits/">Kali Sahasranama benefits in the tradition</a></li>
					<li><a href="/kali-sahasranama-pdf/">Free PDF downloads</a></li>
					<li><a href="/names/">All {totalCount} names by range</a></li>
				</ul>
				<p>{namePages.length} individual name pages are available in total.</p>
			</section>
		</main>
	</body>
</html>
