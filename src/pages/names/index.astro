---
import { getStaticNamesData } from '../../lib/staticNames.js';

const { hub, totalCount, ranges } = getStaticNamesData();

const hubSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${hub.canonical}#webpage`,
      name: 'Adya Mahakali Names Hub',
      description: hub.description,
      url: hub.canonical,
      inLanguage: 'en',
      isPartOf: {
        '@id': 'https://1000namesofmakali.com/#website'
      },
      hasPart: ranges.map((range) => ({
        '@type': 'CollectionPage',
        name: range.heading,
        url: range.canonical
      }))
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${hub.canonical}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://1000namesofmakali.com/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Names Hub',
          item: hub.canonical
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{hub.title}</title>
    <meta name="description" content={hub.description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={hub.title} />
    <meta property="og:description" content={hub.description} />
    <meta property="og:url" content={hub.canonical} />
    <meta property="og:image" content="https://1000namesofmakali.com/MaaAdyaKali_5.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={hub.title} />
    <meta name="twitter:description" content={hub.description} />
    <meta name="twitter:image" content="https://1000namesofmakali.com/MaaAdyaKali_5.webp" />
    <link rel="canonical" href={hub.canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs text summary" />
    <link rel="stylesheet" href="/static-pages.css" />
    <script type="application/ld+json" set:html={JSON.stringify(hubSchema)}></script>
  </head>
  <body class="names-static names-static--hub">
    <main>
      <p class="page-kicker">Static study hub</p>
      <h1>Adya Mahakali Names Hub</h1>

      <figure class="page-figure">
        <img
          src="/MaaAdyaKali_5.webp"
          alt="Statue of Maa Adya Mahakali with a trident, skull garland, and red hibiscus flowers"
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Maa Adya Mahakali — devotional image used on this site.</figcaption>
      </figure>

      <section class="hero-panel">
        <p class="intro">Use this static hub to browse all <strong>{totalCount}</strong> Adya Mahakali names by range. Each section page lists its entries with one-line and detailed English meanings, and every name links to its own reference page with Devanagari, transliteration, alternate spellings, and meaning.</p>
        <nav class="page-nav" aria-label="Hub navigation">
          <ul>
            <li><a href="/">Open the interactive homepage reader</a></li>
            <li><a href="/kali-sahasranama-pdf/">Download the free PDF editions</a></li>
            <li><a href="/sources/">Read sources and editorial notes</a></li>
            <li><a href="/108-names-of-kali/">108 names of Maa Kali</a></li>
            <li><a href="/1008-names-of-kali/">1,008 vs 1,072 names</a></li>
            <li><a href="/kali-sahasranama-lyrics/">Kali Sahasranama lyrics</a></li>
            <li><a href="/kali-sahasranama-benefits/">Kali Sahasranama benefits</a></li>
          </ul>
        </nav>
      </section>

      <section class="ranges-panel" aria-labelledby="ranges-heading">
        <div class="section-heading">
          <p class="section-kicker">Directory</p>
          <h2 id="ranges-heading">Browse by name ranges</h2>
        </div>
        <ol class="range-list">
          {ranges.map((range) => (
            <li>
              <a href={range.path}>{range.heading}</a>
              <div>Starts with {range.firstName.english} and ends with {range.lastName.english}.</div>
            </li>
          ))}
        </ol>
      </section>

      <section class="source-notes" aria-labelledby="hub-source-notes-heading">
        <h2 id="hub-source-notes-heading">Sources and notes</h2>
        <p>This project compiles devotional source material and explanatory meaning notes for spiritual study and chanting support.</p>
        <p>Primary public references used during compilation include:</p>
        <ul>
          <li><a href="https://sanskritdocuments.org/" rel="noopener noreferrer">SanskritDocuments.org</a></li>
        </ul>
        <p>If you notice an inaccuracy, please review the open-source repository or contact the maintainer through the links on the homepage.</p>
      </section>
    </main>
  </body>
</html>
