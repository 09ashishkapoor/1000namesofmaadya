---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import ForeEdge from '../../components/ForeEdge.astro';

import { getStaticNamesData } from '../../lib/staticNames.js';

export function getStaticPaths() {
	const { ranges, namePages } = getStaticNamesData();

	const entryByNumber = new Map();
	const rangeByNumber = new Map();
	for (const range of ranges) {
		for (const entry of range.entries) {
			entryByNumber.set(entry.index, entry);
			rangeByNumber.set(entry.index, range);
		}
	}

	return namePages.map((page, index) => ({
		params: { name: page.slug },
		props: {
			page,
			occurrences: page.numbers.map((number) => ({
				number,
				entry: entryByNumber.get(number),
				range: rangeByNumber.get(number),
			})),
			previousPage: namePages[index - 1] ?? null,
			nextPage: namePages[index + 1] ?? null,
			totalNames: ranges.reduce((total, range) => total + range.entries.length, 0),
		},
	}));
}

const { page, occurrences, previousPage, nextPage, totalNames } = Astro.props;
const { siteUrl } = getStaticNamesData();

const canonical = `${siteUrl}/names/${page.slug}/`;
const primaryOccurrence = occurrences[0];
const primaryRange = primaryOccurrence.range;
const isRepeated = occurrences.length > 1;
const numbersText =
	page.numbers.length === 1
		? String(page.numbers[0])
		: `${page.numbers.slice(0, -1).join(', ')} and ${page.numbers[page.numbers.length - 1]}`;
const numbersLabel = `${isRepeated ? 'names' : 'name'} ${numbersText}`;
const kickerLabel = `${isRepeated ? 'positions' : 'position'} ${numbersText}`;

const secondaries = page.variants.filter(
	(variant) => variant !== page.spelling_site && variant !== page.iast,
);
const alsoSpelled = Array.from(new Set(secondaries)).slice(0, 4);

const siteTitleWithSource = `${page.spelling_common} (${page.spelling_site}) — Meaning in the 1000 Names of Maa Kali`;
const title =
	siteTitleWithSource.length <= 120
		? siteTitleWithSource
		: `${page.spelling_common} — Meaning in the 1000 Names of Maa Kali`;

function truncate(text, maxLength = 158) {
	if (text.length <= maxLength) {
		return text;
	}
	return `${text.slice(0, maxLength - 1).replace(/\s+\S*$/u, '')}…`;
}

const description = truncate(
	`${page.spelling_common} (${page.spelling_site}) is ${numbersLabel} of ${totalNames} in the Adya Mahakali Sahasranama: ${page.meaning}${
		alsoSpelled.length > 0 ? ` Also spelled ${alsoSpelled.join(', ')}.` : ''
	}`,
);

const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	'@id': `${canonical}#breadcrumb`,
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: `${siteUrl}/`,
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Names hub',
			item: `${siteUrl}/names/`,
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: primaryRange.heading,
			item: primaryRange.canonical,
		},
		{
			'@type': 'ListItem',
			position: 4,
			name: page.spelling_common,
			item: canonical,
		},
	],
};

const pageSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		breadcrumbSchema,
		{
			'@type': 'DefinedTerm',
			'@id': `${canonical}#term`,
			name: page.spelling_common,
			alternateName: Array.from(
				new Set([page.spelling_site, ...page.variants, page.devanagari]),
			).filter(Boolean),
			description: page.meaning,
			inLanguage: 'en',
			inDefinedTermSet: {
				'@type': 'DefinedTermSet',
				'@id': `${siteUrl}/names/#termset`,
				name: 'Adya Mahakali Sahasranama (1,000 names of Maa Kali)',
				url: `${siteUrl}/names/`,
			},
			url: canonical,
		},
		{
			'@type': 'Article',
			'@id': `${canonical}#article`,
			headline: `${page.spelling_common} — Meaning in the 1000 Names of Maa Kali`,
			description,
			url: canonical,
			inLanguage: 'en',
			isPartOf: {
				'@id': `${siteUrl}/#website`,
			},
			mainEntity: {
				'@id': `${canonical}#term`,
			},
			author: {
				'@type': 'Person',
				name: 'Kaliputra Ashish',
				url: `${siteUrl}/about/`,
			},
			publisher: {
				'@id': `${siteUrl}/#publisher`,
			},
		},
	],
};
---

<ReferenceLayout
	title={title}
	description={description}
	canonical={canonical}
	schema={pageSchema}
	prevUrl={previousPage ? `${siteUrl}/names/${previousPage.slug}/` : null}
	nextUrl={nextPage ? `${siteUrl}/names/${nextPage.slug}/` : null}
	colophonLabel="The Pothi, name page"
>
	<ForeEdge current={primaryRange.rangeNumber - 1} total={primaryRange.totalRanges} />

	<nav class="breadcrumbs" aria-label="Breadcrumb">
		<ol>
			<li><a href="/">Home</a></li>
			<li><a href="/names/">Names hub</a></li>
			<li><a href={primaryRange.path}>{primaryRange.label}</a></li>
			<li><span aria-current="page">{page.spelling_common}</span></li>
		</ol>
	</nav>

	<p class="page-kicker">Sahasranama {kickerLabel} of the 1,072 names</p>
	<h1 class="dev-title" lang="sa">{page.devanagari}</h1>
	<p class="iast-title">{page.iast}</p>
	<p class="common-title">Also written {page.spelling_common}</p>

	<div class="sheet" style="margin-top:clamp(22px,3vw,36px)">
		<span class="folio" aria-hidden="true">
			{primaryOccurrence.number}
		</span>
		<section class="panel" aria-labelledby="means" style="margin-top:0">
			<h2 class="sec" id="means"><span class="n" lang="sa">अर्थ</span>What {page.spelling_common} means</h2>
			<div class="panel-grid">
				<div>
					<p class="prose lede" style="max-width:none;margin:0 0 16px">
						<strong>{page.spelling_common}</strong> is {numbersLabel} in the <strong
							>Adya Mahakali Sahasranama</strong
						>, the 1,072-name devotional text to Maa Kali. {primaryOccurrence.entry.english_one_line}
					</p>
					<p class="panel-note">
						Sanskrit names travel into English in several romanizations. This page keeps the common spelling,
						the IAST form, and the source transliteration together so the same name is discoverable under each
						spelling readers use.
					</p>
				</div>
				<dl class="spellings">
					<dt>Devanagari</dt>
					<dd lang="sa">{page.devanagari}</dd>
					<dt>IAST</dt>
					<dd>{page.iast}</dd>
					<dt>Common spelling</dt>
					<dd>{page.spelling_common}</dd>
					{
						alsoSpelled.length > 0 && (
							<>
								<dt>Also spelled</dt>
								<dd>{alsoSpelled.join(', ')}</dd>
							</>
						)
					}
					<dt>Source form</dt>
					<dd class="src">{page.spelling_site}</dd>
				</dl>
			</div>
		</section>
	</div>

	<section aria-labelledby="elab" style="margin-top:clamp(30px,4vw,52px)">
		<h2 class="sec" id="elab"><span class="n" lang="sa">विवरण</span>Meaning and elaboration</h2>
		{
			occurrences.map((occurrence) => (
				<div class="prose">
					{isRepeated && (
						<h3 class="dev-sec" id={`name-${occurrence.number}`}>
							Name {occurrence.number}: {occurrence.entry.english_name}
						</h3>
					)}
					<p class="entry-meaning">Meaning — {occurrence.entry.english_one_line}</p>
					{occurrence.entry.english_elaboration_paragraphs.map((paragraph, index) => (
						<p class={index === 0 ? 'lede drop' : undefined}>{paragraph}</p>
					))}
					<p class="entry-meta">
						Position {occurrence.number} of {totalNames} ·{' '}
						<a class="u" href={occurrence.range.path}>Browse range {occurrence.range.label}</a>
					</p>
				</div>
			))
		}
	</section>

	<nav class="pager" aria-label="Name navigation" style="margin-top:clamp(30px,4vw,48px)">
		{
			previousPage ? (
				<a href={`/names/${previousPage.slug}/`}>
					<span class="lab">← Previous name · position {previousPage.primaryNumber}</span>
					<span class="dev" lang="sa">{previousPage.devanagari}</span>
					<span class="iast">{previousPage.iast}</span>
				</a>
			) : (
				<span></span>
			)
		}
		{
			nextPage ? (
				<a href={`/names/${nextPage.slug}/`}>
					<span class="lab">Next name · position {nextPage.primaryNumber} →</span>
					<span class="dev" lang="sa">{nextPage.devanagari}</span>
					<span class="iast">{nextPage.iast}</span>
				</a>
			) : (
				<span></span>
			)
		}
	</nav>

	<div class="seealso" style="margin-top:clamp(28px,3.4vw,44px)">
		<a class="tl" href={primaryRange.path}
			><span class="t">All names in range {primaryRange.label}</span><span class="d"></span><span class="p"
				>range</span
			></a
		>
		<a class="tl" href="/names/"
			><span class="t">All 1,072 names</span><span class="d"></span><span class="p">hub</span></a
		>
		<a class="tl" href="/kali-sahasranama-pdf/"
			><span class="t">PDF edition</span><span class="d"></span><span class="p">68 pages</span></a
		>
		<a class="tl" href="/108-names-of-kali/"
			><span class="t">108 names guide</span><span class="d"></span><span class="p">practice set</span></a
		>
		<a class="tl" href="/"><span class="t">The reader</span><span class="d"></span><span class="p"
				>sets of eleven</span
			></a
		>
		<a class="tl" href="/sources/"
			><span class="t">Sources &amp; corrections</span><span class="d"></span><span class="p">editorial</span></a
		>
	</div>

	<section class="panel" aria-labelledby="sources" style="margin-top:clamp(28px,3.4vw,44px)">
		<h2 class="sec" id="sources"><span class="n" lang="sa">स्रोत</span>Text and sources</h2>
		<p class="prose" style="font-size:16px;margin:0 0 12px">
			The name list follows the Adya Mahakali Sahasranama as compiled for this project. The English meaning and
			elaboration are interpretive notes for devotional study, not a translation of a single critical edition.
		</p>
		<p style="font-size:16px;margin:0 0 8px">
			<a class="u" href="/sources/">Read the editorial method and source notes →</a>
		</p>
		<p style="font-size:15px;color:var(--ash);margin:0">
			<a class="u" href="/about/">About the author</a> ·
			<a class="u" href="/contact/">Contact and corrections</a> ·
			<a class="u" href="/privacy/">Privacy policy</a>
		</p>
	</section>
</ReferenceLayout>
