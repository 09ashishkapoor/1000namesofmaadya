---
import ReferenceLayout from '../../layouts/ReferenceLayout.astro';
import ForeEdge from '../../components/ForeEdge.astro';

import { getStaticNamesData } from '../../lib/staticNames.js';

export function getStaticPaths() {
  const { ranges, totalCount } = getStaticNamesData();

  return ranges.map((range, index) => ({
    params: { range: range.slug },
    props: {
      range,
      allRanges: ranges,
      previousRange: ranges[index - 1] ?? null,
      nextRange: ranges[index + 1] ?? null,
      totalCount
    }
  }));
}

const { range, allRanges, previousRange, nextRange, totalCount } = Astro.props;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${range.canonical}#webpage`,
      name: range.heading,
      description: range.description,
      url: range.canonical,
      inLanguage: 'en',
      isPartOf: {
        '@id': 'https://1000namesofmakali.com/#website'
      },
      mainEntity: {
        '@id': `${range.canonical}#itemlist`
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${range.canonical}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://1000namesofmakali.com/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Names Hub',
          item: 'https://1000namesofmakali.com/names/'
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: range.heading,
          item: range.canonical
        }
      ]
    },
    {
      '@type': 'ItemList',
      '@id': `${range.canonical}#itemlist`,
      name: range.heading,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      numberOfItems: range.entries.length,
      url: range.canonical,
      inLanguage: 'en',
      itemListElement: range.entries.map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `${range.canonical}#name-${entry.index}`,
        name: entry.english_name,
        description: entry.english_one_line
      }))
    }
  ]
};

// Devanagari numerals for the title; the slug and every URL keep the ASCII label.
const DEVANAGARI_DIGITS = ['०', '१', '२', '३', '४', '५', '६', '७', '८', '९'];
function devanagariNumerals(value) {
  return String(value).replace(/\d/g, (digit) => DEVANAGARI_DIGITS[Number(digit)]).replace(/-/g, '–');
}
// The design sets name ranges with an en dash; the path keeps the hyphen.
const enDash = (value) => String(value).replace(/-/g, '–');

const firstEntry = range.entries[0];
const lastEntry = range.entries[range.entries.length - 1];
---

<ReferenceLayout
	title={range.title}
	description={range.description}
	canonical={range.canonical}
	schema={itemListSchema}
	colophonLabel="The Pothi, range page"
>
	<ForeEdge current={range.rangeNumber - 1} total={range.totalRanges} />

	<nav class="breadcrumbs" aria-label="Breadcrumb">
		<ol>
			<li><a href="/">Home</a></li>
			<li><a href="/names/">Names hub</a></li>
			<li><span aria-current="page">{enDash(range.label)}</span></li>
		</ol>
	</nav>

	<p class="page-kicker">Range {range.rangeNumber} of {range.totalRanges} · {range.count} of the {totalCount} names</p>
	<h1 class="num-title">
		<span class="num" lang="sa">{devanagariNumerals(range.label)}</span>
		<span class="iast">Names {enDash(range.label)}</span>
	</h1>
	<p class="common-title">
		{firstEntry?.iast ?? range.firstName.english} → {lastEntry?.iast ?? range.lastName.english}
	</p>

	<nav class="rtabs" aria-label="Name ranges" style="margin-top:clamp(18px,2.4vw,26px)">
		{allRanges.map((item) => (
			<a href={item.path} aria-current={item.slug === range.slug ? 'page' : undefined}>
				{enDash(item.label)}
			</a>
		))}
	</nav>

	<div
		class="sechead"
		style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin:22px 0 6px;flex-wrap:wrap"
	>
		<h2 class="sec" style="border:0;margin:0;flex:1">
			<span class="n" lang="sa">पाठ</span>{range.heading}
		</h2>
		<span
			class="meta"
			style="font-family:var(--serif);font-size:12.5px;font-variant:all-small-caps;letter-spacing:.12em;color:var(--ash)"
			>Devanagari · IAST · meaning</span
		>
	</div>

	<ol class="index-cols index-list">
		{range.entries.map((entry) => (
			<li id={`name-${entry.index}`}>
				<a class="nrow" href={entry.page_slug ? `/names/${entry.page_slug}/` : `/names/${range.slug}/#name-${entry.index}`}>
					<span class="no">{String(entry.index).padStart(2, '0')}</span>
					<span>
						<span class="dev" lang="sa">{entry.devanagari ?? entry.english_name}</span>
						<span class="iast">{entry.iast ?? ''}</span>
						<span class="one">{entry.english_one_line}</span>
					</span>
				</a>
			</li>
		))}
	</ol>

	<nav class="pager" aria-label="Range navigation" style="margin-top:clamp(26px,3vw,40px)">
		{previousRange ? (
			<a href={previousRange.path}>
				<span class="lab">← Previous range · {enDash(previousRange.label)}</span>
				<span class="dev" lang="sa">{devanagariNumerals(previousRange.label)}</span>
			</a>
		) : (
			<span></span>
		)}
		{nextRange ? (
			<a href={nextRange.path}>
				<span class="lab">Next range · {enDash(nextRange.label)} →</span>
				<span class="dev" lang="sa">{devanagariNumerals(nextRange.label)}</span>
			</a>
		) : (
			<span></span>
		)}
	</nav>

	<section class="panel" aria-labelledby="note" style="margin-top:clamp(26px,3vw,40px)">
		<h2 class="sec" id="note"><span class="n" lang="sa">स्रोत</span>About these pages</h2>
		<p class="prose" style="font-size:16px;margin:0 0 12px">
			This page is a static collection of Adya Mahakali names {range.label} with English meanings. It begins with
			<strong>{range.firstName.english}</strong> and ends with <strong>{range.lastName.english}</strong>, giving
			search engines and readers a crawlable reference for this part of the Sahasranama without JavaScript.
		</p>
		<p class="prose" style="font-size:16px;margin:0 0 12px">
			This section covers names <strong>{range.start}</strong> through <strong>{range.end}</strong> from the full set
			of <strong>{totalCount}</strong> names. Each name above links to its own reference page with Devanagari,
			transliteration, alternate spellings, and the full meaning.
		</p>
		<p class="prose" style="font-size:16px;margin:0 0 12px">
			Use the entries above as direct references for meanings in this range, or move through the previous and next
			range links to continue the full Adya Mahakali Sahasranama sequence. Ten ranges of one hundred names, then a
			final range of seventy-two. The same text is available as a printable PDF.
		</p>
		<nav class="page-nav" aria-label="Page navigation" style="margin:0 0 10px">
			<ul>
				<li><a href="/">Open the interactive homepage reader</a></li>
				<li><a href="/names/">Browse all ranges</a></li>
				<li><a href="/kali-sahasranama-pdf/">Download the PDF edition</a></li>
				<li><a href="/108-names-of-kali/">108 names of Maa Kali</a></li>
				<li><a href="/1008-names-of-kali/">1,008 vs 1,072 names</a></li>
				{previousRange && <li><a href={previousRange.path}>← Previous range ({enDash(previousRange.label)})</a></li>}
				{nextRange && <li><a href={nextRange.path}>Next range ({enDash(nextRange.label)}) →</a></li>}
			</ul>
		</nav>
		<p style="font-size:15px;color:var(--ash);margin:0">
			<a class="u" href="/sources/">Editorial method</a> ·
			<a class="u" href="/kali-sahasranama-pdf/">PDF edition</a> ·
			<a class="u" href="/108-names-of-kali/">108 names guide</a>
		</p>
	</section>
</ReferenceLayout>
